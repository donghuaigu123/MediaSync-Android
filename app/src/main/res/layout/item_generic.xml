<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingLeft="14dp" android:paddingRight="14dp"
    android:paddingTop="5dp" android:paddingBottom="5dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp" android:tag="card"
        android:gravity="center_vertical">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/gTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:singleLine="true" android:ellipsize="middle"
                android:textSize="14sp" android:textStyle="bold"
                android:textColor="?attr/msText" />
            <TextView android:id="@+id/gSubtitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textSize="11sp"
                android:lineSpacingExtra="2dp" android:textColor="?attr/msSub" />
            <TextView android:id="@+id/gTag"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:paddingLeft="8dp" android:paddingRight="8dp"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:textSize="10sp" android:textColor="?attr/msAccent" android:tag="badge" />
        </LinearLayout>

        <LinearLayout android:id="@+id/gActions"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginLeft="8dp" android:orientation="vertical" android:gravity="end" />
    </LinearLayout>
</LinearLayout>
